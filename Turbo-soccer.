local RunService = game:GetService("RunService")
local Players = game:GetService("Players")

local cfg = {
    on = true,
    steps = 200,
    dt = 0.05,
    thick = 0.4,
    trans = 0.15,
    color = Color3.fromRGB(0, 255, 150),
    bcolor = Color3.fromRGB(255, 60, 60),
    marker = true,
    radius = 1,
    minspeed = 3,
    smooth = 0.6,
    bounce = true,
    maxb = 2,
    damp = 0.75,
    minb = 8,
}

local ballModel, ball, mode, useInd = nil, nil, "?", false

local function path(...)
    local c = workspace
    for _, n in ipairs({...}) do
        c = c:FindFirstChild(n)
        if not c then return nil end
    end
    return c
end

local function findBall()
    useInd = false

    local r = path("CarSoccer", "MatchView", "Ball")
    if r then
        local p = r:FindFirstChild("ball")
        if p and p:IsA("BasePart") then
            ballModel, mode = r, "Ranked"
            return p
        end
    end

    local f = path("CarSoccer", "Ball")
    if f then
        local p = f:FindFirstChild("ball")
        if p and p:IsA("BasePart") then
            ballModel, mode = f, "Free"
            return p
        end
    end

    local ind = path("CarSoccer", "BallIndicator")
    if ind and ind:IsA("BasePart") then
        ballModel, mode, useInd = nil, "Juggernaut", true
        return ind
    end

    for _, o in ipairs(workspace:GetDescendants()) do
        if o:IsA("BasePart") and string.lower(o.Name) == "ball" then
            ballModel, mode = o.Parent, "Fallback"
            return o
        end
    end
end

local function getPos()
    if useInd then
        if ball and ball.Parent then return ball.Position end
        return nil
    end

    if ballModel and ballModel.Parent then
        local root = ballModel:FindFirstChild("Root")
        if root and root:IsA("BasePart") then return root.Position end
        if ballModel.PrimaryPart then return ballModel.PrimaryPart.Position end
        return ballModel:GetPivot().Position
    end

    if ball and ball.Parent then return ball.Position end
end

local old = workspace:FindFirstChild("TrajectoryFolder")
if old then old:Destroy() end

local folder = Instance.new("Folder")
folder.Name = "TrajectoryFolder"
folder.Parent = workspace

local pool, bpool = {}, {}
local mk = nil
local lp, lt = nil, nil
local vel = Vector3.zero

local function newPart(c)
    local p = Instance.new("Part")
    p.Anchored = true
    p.CanCollide = false
    p.CanQuery = false
    p.CanTouch = false
    p.Material = Enum.Material.Neon
    p.Color = c
    p.Transparency = cfg.trans
    p.Shape = Enum.PartType.Cylinder
    p.CastShadow = false
    p.Locked = true
    p.Parent = folder
    return p
end

local function getPart(t, i, c)
    if t[i] and t[i].Parent then return t[i] end
    t[i] = newPart(c)
    return t[i]
end

local function hideFrom(t, n)
    for i = n, #t do
        if t[i] and t[i].Parent then t[i].Transparency = 1 end
    end
end

local function hideAll()
    hideFrom(pool, 1)
    hideFrom(bpool, 1)
    if mk then mk.Transparency = 1 end
end

local rp = RaycastParams.new()
rp.FilterType = Enum.RaycastFilterType.Exclude
rp.IgnoreWater = true

local function updateFilter()
    local f = {folder}
    if ballModel then table.insert(f, ballModel) end
    for _, pl in ipairs(Players:GetPlayers()) do
        if pl.Character then table.insert(f, pl.Character) end
    end
    rp.FilterDescendantsInstances = f
end

local function predict(sp, sv)
    local segs = {}
    local cur = {}
    local p = sp
    local v = sv
    local g = workspace.Gravity
    local b = 0
    local c = cfg.color

    updateFilter()

    for i = 1, cfg.steps do
        local nv = Vector3.new(v.X, v.Y - g * cfg.dt, v.Z)
        local np = p + nv * cfg.dt
        local hit = workspace:Raycast(p, np - p, rp)

        if hit then
            table.insert(cur, hit.Position)
            table.insert(segs, {pts = cur, color = c})
            local n = hit.Normal
            local refl = nv - 2 * nv:Dot(n) * n
            cur = {}
            p = hit.Position + n * 0.15
            v = refl * cfg.damp
            c = cfg.bcolor
            b = b + 1
            if b >= cfg.maxb then break end
            if v.Magnitude < cfg.minb then break end
        else
            table.insert(cur, np)
            p = np
            v = nv
            if p.Y - cfg.radius <= 0 then break end
            if math.abs(p.X) > 3000 or math.abs(p.Z) > 3000 then break end
        end
    end

    if #cur > 1 then
        table.insert(segs, {pts = cur, color = c})
    end
    return segs
end

local function draw(t, pts, c)
    local n = 0
    for i = 1, #pts - 1 do
        local a, b = pts[i], pts[i + 1]
        local d = b - a
        local l = d.Magnitude
        if l > 0.01 then
            n = n + 1
            local p = getPart(t, n, c)
            p.Color = c
            p.Size = Vector3.new(l, cfg.thick, cfg.thick)
            p.CFrame = CFrame.new((a + b) / 2, b) * CFrame.Angles(0, math.rad(90), 0)
            p.Transparency = cfg.trans
        end
    end
    hideFrom(t, n + 1)
end

local function drawAll(segs)
    if segs[1] then
        draw(pool, segs[1].pts, cfg.color)
    else
        hideFrom(pool, 1)
    end

    if segs[2] then
        local all = {}
        for i = 2, #segs do
            for _, pt in ipairs(segs[i].pts) do
                table.insert(all, pt)
            end
        end
        draw(bpool, all, cfg.bcolor)
    else
        hideFrom(bpool, 1)
    end

    local last = segs[#segs]
    if last and #last.pts > 0 then
        return last.pts[#last.pts]
    end
end

local function marker(pos)
    if not cfg.marker or not pos then
        if mk then mk.Transparency = 1 end
        return
    end
    if not mk or not mk.Parent then
        mk = Instance.new("Part")
        mk.Anchored = true
        mk.CanCollide = false
        mk.CanQuery = false
        mk.Material = Enum.Material.Neon
        mk.Shape = Enum.PartType.Ball
        mk.Color = Color3.fromRGB(255, 120, 0)
        mk.Size = Vector3.new(2, 2, 2)
        mk.Transparency = 0.3
        mk.Parent = folder
    end
    mk.Position = Vector3.new(pos.X, 0.25, pos.Z)
    mk.Transparency = 0.3
end

ball = findBall()
if ball then
    cfg.radius = ball.Size.Y / 2
    lp = getPos()
    lt = tick()
end

RunService.Heartbeat:Connect(function()
    if not cfg.on then
        hideAll()
        return
    end

    if not ball or not ball.Parent then
        ball = findBall()
        if ball then
            cfg.radius = ball.Size.Y / 2
            lp = getPos()
            lt = tick()
            vel = Vector3.zero
        end
        return
    end

    local cp = getPos()
    if not cp then return end

    local now = tick()
    local d = now - lt

    if d > 0 and lp then
        local raw = (cp - lp) / d
        vel = vel * (1 - cfg.smooth) + raw * cfg.smooth
        lp = cp
        lt = now
    end

    if vel.Magnitude < cfg.minspeed then
        hideAll()
        return
    end

    local segs = predict(cp, vel)
    if #segs == 0 or #segs[1].pts < 2 then
        hideAll()
        return
    end

    local endp = drawAll(segs)
    marker(endp)
end)

